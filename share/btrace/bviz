#!/usr/bin/env python3
#
# bviz - real-time btrace histogram visualizer
#
# Reads NDJSON from btrace -j output and renders live heatmaps and charts.
#
# Usage:
#   btrace -j -e 'script' | bviz
#   btrace -j script.bt | bviz
#   btrace -j script.bt | bviz --speedscope > profile.speedscope
#
# Supported types emitted by btrace -j:
#   maphist  @map[key] = hist(v)  -> 2-D heatmap (rows=keys, cols=buckets)
#   hist     @h = hist(v)         -> bar chart
#   map      @map[key] = count()  -> bar chart sorted by value
#   map      @map[kstack] = count() -> vertical icicle chart (root left,
#                                      depth right, height ∝ sample count)
#
# With --speedscope: accumulates stack samples and writes a speedscope-format
# JSON file to stdout on exit.  Open the result at https://speedscope.app.

import json
import os
import sys
import time

ESC   = '\033'
RESET = ESC + '[0m'
BOLD  = ESC + '[1m'
CLEAR = ESC + '[2J' + ESC + '[H'

# Intensity characters (low to high)
_INTENSITY = ['.', '\u2591', '\u2592', '\u2593', '\u2588']  # . ░ ▒ ▓ █

def _intensity(val, row_max):
    """Map val/row_max to a single display character."""
    if row_max == 0 or val == 0:
        return _INTENSITY[0]
    r = val / row_max
    if r < 0.05:
        return _INTENSITY[1]
    elif r < 0.20:
        return _INTENSITY[2]
    elif r < 0.60:
        return _INTENSITY[3]
    else:
        return _INTENSITY[4]

def _fmt_bucket(key_int, step):
    """
    Format a histogram bucket label.
    For power-of-2 (step==0), key is the upper bound of [key/2, key).
    For linear (step>0), key is the upper bound of [key-step, key).
    """
    k = key_int
    if step == 0:
        if k < 0:
            return '<0'
        elif k == 0:
            return '0'
        else:
            # upper bound; apply unit suffix
            v = k
            for unit, suffix in ((1 << 60, 'E'), (1 << 50, 'P'),
                                  (1 << 40, 'T'), (1 << 30, 'G'),
                                  (1 << 20, 'M'), (1 << 10, 'K')):
                if v >= unit:
                    return f'{v // unit}{suffix}'
            return str(v)
    else:
        return f'{k - step}-{k}'


def render_maphist(obj):
    """2-D heatmap: rows = outer map keys, cols = histogram buckets."""
    name  = obj['name']
    data  = obj['data']
    step  = obj.get('step', 0)
    ts    = obj.get('ts', 0)

    if not data:
        return

    # Collect all bucket keys across all entries
    all_buckets = set()
    for entry in data.values():
        all_buckets.update(int(k) for k in entry.keys())
    sorted_buckets = sorted(all_buckets)

    # Sort outer keys numerically where possible
    try:
        sorted_keys = sorted(data.keys(), key=int)
    except ValueError:
        sorted_keys = sorted(data.keys())

    ts_str = time.strftime('%H:%M:%S', time.localtime(ts))
    print(f'{BOLD}@{name}{RESET}  [{ts_str}]')

    # Column header
    key_w   = max(len(str(k)) for k in sorted_keys)
    col_w   = 5
    header  = ' ' * (key_w + 1) + '|'
    for b in sorted_buckets:
        lbl = _fmt_bucket(b, step)
        header += f'{lbl:^{col_w}}'
    header += '  total'
    print(header)
    print('-' * (key_w + 1) + '+' + '-' * (col_w * len(sorted_buckets) + 7))

    for key in sorted_keys:
        entry   = {int(k): v for k, v in data[key].items()}
        row_max = max(entry.values(), default=0)
        total   = sum(entry.values())

        row = f'{key:>{key_w}} |'
        for b in sorted_buckets:
            val = entry.get(b, 0)
            ch  = _intensity(val, row_max)
            row += f'{ch:^{col_w}}'
        row += f'  {total}'
        print(row)


def render_hist(obj):
    """Single histogram as a bar chart."""
    name = obj['name']
    data = {int(k): v for k, v in obj['data'].items()}
    step = obj.get('step', 0)
    ts   = obj.get('ts', 0)

    if not data:
        return

    sorted_buckets = sorted(data.keys())
    max_val   = max(data.values(), default=0)
    bar_width = 48
    ts_str    = time.strftime('%H:%M:%S', time.localtime(ts))

    print(f'{BOLD}@{name}{RESET}  [{ts_str}]')
    for b in sorted_buckets:
        val = data[b]
        lbl = _fmt_bucket(b, step)
        i   = int(bar_width * val / max_val) if max_val > 0 else 0
        print(f'{lbl:>8} {val:8d} |{"#" * i}{" " * (bar_width - i)}|')


def _parse_stack(key_str):
    """
    Parse a btrace kstack/ustack key into a list of frame names,
    outermost (root-ward) first.

    btrace formats each frame as '\nfuncname+0xOFFSET'; the final
    frame is '\nkernel\n' or '\nuserland\n'.  We strip offsets and
    reverse so the outermost frame comes first (root at top in the
    icicle chart).
    """
    frames = []
    for f in key_str.split('\n'):
        f = f.strip()
        if not f:
            continue
        # strip +0xOFFSET
        plus = f.find('+')
        if plus > 0:
            f = f[:plus]
        frames.append(f)
    frames.reverse()
    return frames


def _build_flame_tree(data):
    """
    Build a prefix tree from {stack_str: count}.
    Each node: {'total': N, 'children': {name: node}}.
    """
    root = {'total': 0, 'children': {}}
    for key_str, count in data.items():
        count = int(count)
        frames = _parse_stack(key_str)
        root['total'] += count
        node = root
        for frame in frames:
            if frame not in node['children']:
                node['children'][frame] = {'total': 0, 'children': {}}
            node = node['children'][frame]
            node['total'] += count
    return root


# ── Vertical icicle chart ───────────────────────────────────────────────
# Each column = one call-stack depth level; cell height ∝ sample count.
# Color is inherited from the depth-1 ancestor so related branches share
# a hue.  All cells use bright-white foreground on a dark background.

# 256-color backgrounds: dark/medium shades with good white-text contrast.
_IC_PALETTE = [
    22,   # dark green
    18,   # dark navy
    52,   # dark maroon
    58,   # dark olive
    23,   # dark teal
    53,   # dark purple
    88,   # dark crimson
    130,  # dark orange-brown
    28,   # medium green
    24,   # medium blue
    54,   # dark violet
    94,   # dark gold
    30,   # dark cyan
    19,   # blue-purple
    89,   # dark fuchsia
    100,  # dark yellow-green
]
_IC_ROOT_BG  = 236   # root "all" cell: very dark gray
_IC_EMPTY_BG = 234   # unused grid cells: near-black
_IC_SEP_BG   = 232   # column separator: darkest gray
_IC_FG       = 231   # bright white text
_IC_COL_W    = 20    # total column width (content + 1-char separator)
_IC_CELL_W   = _IC_COL_W - 1  # usable content width per cell


def render_flamegraph(obj):
    """
    Vertical icicle chart: root at left, depth grows rightward.

    Each column is a call-stack depth level.  Within a column, sibling
    cells are stacked top-to-bottom sorted by sample count (most frequent
    first).  Cell height is proportional to sample count.  Color is
    assigned per top-level branch and inherited by all descendants.
    """
    name  = obj['name']
    data  = obj['data']
    ts    = obj.get('ts', 0)

    try:
        sz     = os.get_terminal_size()
        term_h = max(8,  min(sz.lines - 3, 300))
        term_w = max(40, min(sz.columns,   500))
    except OSError:
        term_h, term_w = 40, 120

    ts_str = time.strftime('%H:%M:%S', time.localtime(ts))
    print(f'{BOLD}@{name}{RESET}  [{ts_str}]')

    root  = _build_flame_tree(data)
    total = root['total']
    if total == 0:
        return

    max_depth = max(1, term_w // _IC_COL_W)

    # ── 1. Collect layout ────────────────────────────────────────────────
    # Skip the boring all→kernel (or all→userland) single-child prefix:
    # any leading node with exactly one child is always shown at 100% and
    # adds no useful information.
    display_root = root
    while len(display_root['children']) == 1:
        display_root = next(iter(display_root['children'].values()))

    # items: list of (depth, y0, cell_h, label, node_total, bg_color)
    items = []

    def _name_color(name):
        """Stable per-name color from the palette."""
        return _IC_PALETTE[abs(hash(name)) % len(_IC_PALETTE)]

    def _collect(node, depth, y_lo, y_hi, label, bg):
        if depth >= max_depth or (y_hi - y_lo) * term_h < 0.5:
            return
        y0     = round(y_lo * term_h)
        cell_h = max(1, round(y_hi * term_h) - y0)
        items.append((depth, y0, cell_h, label, node['total'], bg))
        children = sorted(node['children'].items(),
                          key=lambda kv: -kv[1]['total'])
        span = y_hi - y_lo
        cum  = y_lo
        for cname, cnode in children:
            cf = span * cnode['total'] / node['total']
            _collect(cnode, depth + 1, cum, cum + cf, cname, _name_color(cname))
            cum += cf

    # Seed the first visible column from display_root's children.
    children = sorted(display_root['children'].items(),
                      key=lambda kv: -kv[1]['total'])
    cum = 0.0
    for cname, cnode in children:
        cf = cnode['total'] / display_root['total']
        _collect(cnode, 0, cum, cum + cf, cname, _name_color(cname))
        cum += cf

    # ── 2. Build character grid ──────────────────────────────────────────
    bg_grid = [[_IC_EMPTY_BG] * term_w for _ in range(term_h)]
    ch_grid = [[' ']           * term_w for _ in range(term_h)]

    for depth, y0, cell_h, label, node_total, bg in items:
        x0 = depth * _IC_COL_W
        x1 = min(x0 + _IC_CELL_W, term_w)
        if x0 >= term_w:
            continue
        for row in range(y0, min(y0 + cell_h, term_h)):
            for col in range(x0, x1):
                bg_grid[row][col] = bg
        pct  = int(node_total * 100 / total)
        text = f'{pct:3d}% {label}'
        for i, c in enumerate(text[:_IC_CELL_W]):
            if y0 < term_h:
                ch_grid[y0][x0 + i] = c

    # Separator columns between depth levels
    for d in range(1, max_depth + 1):
        sep = d * _IC_COL_W - 1
        if sep >= term_w:
            break
        for row in range(term_h):
            bg_grid[row][sep] = _IC_SEP_BG
            ch_grid[row][sep] = ' '

    # ── 3. Render ────────────────────────────────────────────────────────
    _FG = f'\033[38;5;{_IC_FG}m'
    for row in range(term_h):
        parts   = []
        prev_bg = -1
        for col in range(term_w):
            bg = bg_grid[row][col]
            if bg != prev_bg:
                parts.append(f'\033[48;5;{bg}m{_FG}')
                prev_bg = bg
            parts.append(ch_grid[row][col])
        parts.append(RESET)
        sys.stdout.write(''.join(parts) + '\n')


def render_map(obj):
    """Map as a bar chart, or a flame graph if keys are stack traces."""
    name = obj['name']
    data = obj['data']
    ts   = obj.get('ts', 0)

    # kstack/ustack keys contain '\n'-separated frames
    if data and any('\n' in k for k in data):
        render_flamegraph(obj)
        return

    if not data:
        return

    try:
        items = sorted(data.items(), key=lambda x: -int(x[1]))
    except (ValueError, TypeError):
        items = sorted(data.items())

    max_val   = int(items[0][1]) if items else 0
    bar_width = 48
    ts_str    = time.strftime('%H:%M:%S', time.localtime(ts))

    print(f'{BOLD}@{name}{RESET}  [{ts_str}]')
    for key, val in items:
        v = int(val)
        i = int(bar_width * v / max_val) if max_val > 0 else 0
        print(f'{key:>16} {v:8d} |{"#" * i}{" " * (bar_width - i)}|')


def _to_speedscope(stacks_by_name):
    """
    Convert {name: {stack_str: count}} to a speedscope-format dict.

    speedscope sampled profile layout:
      shared.frames  - deduplicated frame name table
      profiles[]     - one entry per named map
        samples[]    - each stack as [root_idx, ..., leaf_idx]
        weights[]    - sample count for each stack
    """
    frame_index = {}
    frames = []

    profiles = []
    for name, data in stacks_by_name.items():
        samples = []
        weights = []
        for key_str, count in data.items():
            parsed = _parse_stack(key_str)   # outermost (root) first
            if not parsed:
                continue
            indices = []
            for fname in parsed:
                if fname not in frame_index:
                    frame_index[fname] = len(frames)
                    frames.append({'name': fname})
                indices.append(frame_index[fname])
            samples.append(indices)
            weights.append(int(count))

        total = sum(weights)
        profiles.append({
            'type': 'sampled',
            'name': name,
            'unit': 'none',
            'startValue': 0,
            'endValue': total,
            'samples': samples,
            'weights': weights,
        })

    return {
        '$schema': 'https://www.speedscope.app/file-format-schema.json',
        'shared': {'frames': frames},
        'profiles': profiles,
        'name': 'btrace profile',
        'activeProfileIndex': 0,
        'exporter': 'bviz',
    }


def main():
    speedscope = '--speedscope' in sys.argv

    # accumulate: name -> {stack_str: total_count}
    accumulated = {}
    sections    = {}

    if not speedscope:
        print(CLEAR, end='', flush=True)

    try:
        for line in sys.stdin:
            line = line.strip()
            if not line:
                continue
            try:
                obj = json.loads(line)
            except json.JSONDecodeError:
                print(line, file=sys.stderr)
                continue

            name = obj.get('name', '?')
            t    = obj.get('type')
            data = obj.get('data', {})

            if speedscope:
                # Only accumulate stack maps (keys contain '\n')
                if t == 'map' and data and any('\n' in k for k in data):
                    bucket = accumulated.setdefault(name, {})
                    for k, v in data.items():
                        bucket[k] = bucket.get(k, 0) + int(v)
                continue

            sections[name] = obj

            print(CLEAR, end='')
            for n, o in sections.items():
                ot = o.get('type')
                if ot == 'maphist':
                    render_maphist(o)
                elif ot == 'hist':
                    render_hist(o)
                elif ot == 'map':
                    render_map(o)
                print()
            sys.stdout.flush()

    except KeyboardInterrupt:
        pass
    finally:
        if speedscope:
            json.dump(_to_speedscope(accumulated), sys.stdout,
                      separators=(',', ':'))
            sys.stdout.write('\n')
            sys.stdout.flush()
        else:
            print(RESET)


if __name__ == '__main__':
    main()
