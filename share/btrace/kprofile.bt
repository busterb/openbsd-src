/*
 * kprofile.bt	Kernel CPU profiling (stack sampling) at 100Hz.
 *
 * Live flame graph in the terminal (icicle chart, Ctrl+C to stop):
 *	btrace -V /usr/share/btrace/kprofile.bt
 *
 * Live flame graph via bviz (requires bviz in PATH):
 *	btrace -j /usr/share/btrace/kprofile.bt | bviz
 *
 * To produce a FlameGraph SVG using the FlameGraph tools at
 * https://github.com/brendangregg/FlameGraph:
 *	btrace /usr/share/btrace/kprofile.bt > kprofile.txt
 *	stackcollapse-bpftrace.pl kprofile.txt | flamegraph.pl > kprofile.svg
 */
profile:hz:100 {
	@[kstack] = count();
}
