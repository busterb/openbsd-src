/*
 * uprofile.bt	Userland CPU profiling (stack sampling) at 100Hz.
 *
 * The PID to profile is passed as the first argument.  The process must
 * be compiled with -fno-omit-frame-pointer for stack unwinding to work.
 * Collects samples until Ctrl+C; for a live rolling flame graph use
 * uflamegraph.bt instead.
 *
 * To produce a FlameGraph SVG using the FlameGraph tools at
 * https://github.com/brendangregg/FlameGraph:
 *	btrace /usr/share/btrace/uprofile.bt 12345 > uprofile.txt
 *	stackcollapse-bpftrace.pl uprofile.txt | flamegraph.pl > uprofile.svg
 */
profile:hz:100 / pid == $1 / {
	@[ustack] = count();
}
