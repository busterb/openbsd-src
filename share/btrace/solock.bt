/*	$OpenBSD: solock.bt,v 1.1 2025/07/21 21:15:05 bluhm Exp $	*/

/*
 * solock: stack sampling of socket lock contension
 *  - probe: netlock, solock
 *  - arg0: pointer to struct rwlock
 *  - arg1: lock type
 *    - 1: read lock
 *    - 2: write lock
 *  - arg2: success status
 *    - 1: locked immediately
 *    - 2: locked after spinning
 *    - 3: locked after sleeping
 *    - 4: locking failed
 *
 * Live flame graph in the terminal (Ctrl+C to stop):
 *	btrace -V /usr/share/btrace/solock.bt
 *
 * To produce a FlameGraph SVG using the FlameGraph tools at
 * https://github.com/brendangregg/FlameGraph:
 *	btrace /usr/share/btrace/solock.bt > solock.txt
 *	stackcollapse-bpftrace.pl solock.txt | flamegraph.pl > solock.svg
 */
tracepoint:rwlock:solock {
	if (arg2 >= 2) {
		@[kstack] = count();
	}
}
END {
	print(@);
}
